# Copy this file to .env to point the app to another backend.
# Only variables starting with VITE_ reach the browser: never put secrets here.

# Backend URL (without a trailing slash)
VITE_API_URL=http://localhost:3000

# Public address of the AI service (optional). The browser only uses it to wake the
# service up before asking for a route. In Vercel: https://urban-road-monitor-ai.onrender.com
VITE_AI_SERVICE_URL=
